{
  "rewrites": [
    { "source": "/((?!api|sitemap\\.xml|robots\\.txt|manifest\\.json|sw\\.js|favicon\\.ico|assets|icons).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/keep-alive",
      "schedule": "0 5 * * *"
    }
  ]
}
